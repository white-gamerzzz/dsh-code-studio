{
  "name": "dsh-plugin-code-studio",
  "version": "0.2.0",
  "private": true,
  "description": "代码工作室：子 Agent 团队的协调工具——issue 台账、git worktree 副本、结算回写、合并闸门；插件不派子 Agent，主 Agent 自己组织团队。",
  "meta": {
    "title": "代码工作室",
    "description": "把代码生产的质量控制从主观判断变成可计算流程：台账、副本隔离、漂移检查、独立审校。"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./code-guard": {
      "default": "./lib/code-guard.js"
    },
    "./client": "./lib/client.js",
    "./lib/session-roles": "./lib/session-roles.js",
    "./lib/dispatch": "./lib/dispatch.js",
    "./lib/executor": "./lib/executor.js",
    "./lib/packet": "./lib/packet.js",
    "./lib/runner": "./lib/runner.js",
    "./lib/kb": "./lib/kb.js",
    "./lib/map": "./lib/map.js",
    "./lib/review": "./lib/review.js",
    "./lib/embedder": "./lib/embedder.js",
    "./lib/studio-store": "./lib/studio-store.js",
    "./lib/studio-memory": "./lib/studio-memory.js",
    "./lib/studio-dispatch": "./lib/studio-dispatch.js",
    "./lib/studio-memory-index": "./lib/studio-memory-index.js",
    "./lib/studio-watch": "./lib/studio-watch.js",
    "./lib/studio-github": "./lib/studio-github.js",
    "./lib/studio-pr": "./lib/studio-pr.js",
    "./lib/studio-intake": "./lib/studio-intake.js",
    "./lib/studio-route": "./lib/studio-route.js",
    "./lib/studio-workspace": "./lib/studio-workspace.js",
    "./lib/studio-rules": "./lib/studio-rules.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./lib/studio-repo": "./lib/studio-repo.js",
    "./lib/studio-web": "./lib/studio-web.js",
    "./lib/studio-theme": "./lib/studio-theme.js"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "web"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "code",
    "studio",
    "orchestration",
    "multi-agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "smoke": "node -e \"import('./lib/index.js')\"",
    "build:web": "node scripts/mkappcss.cjs && vite build",
    "dev:web": "node scripts/mkappcss.cjs && vite build --watch"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.7",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}